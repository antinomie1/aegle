Column {
    width: 240dp
    TreeView {
        id: tree
        TreeNode { id: docs; text: "文档"; expanded: true
            TreeNode { id: guide; text: "指南"; selected: true }
            TreeNode { text: "参考" }
        }
        TreeNode { id: samples; text: "示例"; TreeNode { text: "隐藏" } }
    }
    Text { id: note; text: "Aegle wraps this longer note inside the narrow column, so it needs more than one line."; wrap: true }
    Dropdown { id: color; items: ["红", "绿", "蓝"]; selected: 1 }
    CheckBox { id: agree; text: "我已阅读并同意上面这段很长的条款说明"; wrap: true }
}
