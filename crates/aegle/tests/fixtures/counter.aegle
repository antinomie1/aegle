use "parts.aegle"
Column {
    state count: int = 0
    state tags: list<string> = ["new"]
    Text { id: status; text: "count " + str(count) }
    Button { id: add; text: "add"; on clicked { count += 1; tags += [str(count)] } }
    Badge { value: count }
    for tag in tags { Text { text: tag } }
}
