// A dropdown, text-change events, tree nodes from blocks, named slot content,
// a file picker and an image.
component Labeled(label: string) {
    Column {
        Text { text: label }
        slot
    }
}
Column {
    state size: int = 1
    state picked: string = ""
    state typed: string = ""
    state edits: int = 0
    state folders: list<string> = ["文档", "示例"]
    state choices: list<string> = ["小", "中", "大"]
    Dropdown {
        id: sizes; selected: size; items: choices
        on changed { size = self.selected; picked = self.text }
    }
    Labeled { label: "名称"; TextField { id: name; on changed { typed = self.text; edits += 1 } } }
    FilePicker { id: export; mode: save; title: "导出"; filters: ["*.png"]; button_text: "浏览" }
    Image { id: preview; source: ""; fit: cover; width: 16dp; height: 16dp }
    TreeView {
        TreeNode {
            id: top; text: "根"; expanded: true
            for folder in folders {
                TreeNode { text: folder; if folder == "文档" { TreeNode { text: "指南" } } }
            }
        }
    }
}
