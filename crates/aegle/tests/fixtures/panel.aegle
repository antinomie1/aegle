ScrollView {
    id: panel
    padding: 3dp
    width: 240dp
    height: 180dp
    background: #F6F7F9FF
    border_color: #737D8C
    border_width: 1dp
    radius: 8dp
    transition: [120ms, ease_out]
    Row {
        gap: 4dp
        Text { id: status; text: "等待" }
        Button {
            id: clear; text: "Clear"; width: 80dp
            foreground: #FFFFFF
            background: #6750A4
            hover_background: #5B4482
            pressed_background: #422D67
            disabled_background: #737D8C
            disabled_foreground: #20242B
            focus_color: #A78BE8
            focus_width: 3dp
            transition: [120ms, ease_in_out]
        }
    }
    TextField {
        id: editor; text: "你好"; label: "Editor"
        font_size: 16dp
        caret_color: #6750A4
        selection_color: #D5DFFF
    }
    TextArea { id: multiline; text: "one\ntwo"; height: 70dp; min_height: 0dp }
    CheckBox { id: check; text: "Accept"; checked: true; indicator_color: #6750A4 }
    Switch { id: switch; text: "Enabled"; indicator_color: #6750A4 }
    Row { RadioButton { text: "One"; checked: true }; RadioButton { id: radio; text: "Two"; checked: true } }
    Slider { id: slider; value: 99; max: 20; min: 10; step: 3; indicator_color: #6750A4 }
    Progress { id: progress; value: -100; max: 20; min: 10; indicator_color: #6750A4 }
}
